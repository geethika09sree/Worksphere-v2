# MongoDB Atlas connection string. Put the database name before the "?", e.g. /worksphere
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/worksphere?retryWrites=true&w=majority
# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d
# Comma-separated frontend origins allowed by CORS (no trailing slash)
CLIENT_ORIGINS=http://localhost:5173
# Only used by `npm run create-admin`
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
